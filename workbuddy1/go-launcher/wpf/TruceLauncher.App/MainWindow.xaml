<Window x:Class="TruceLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:TruceLauncher"
        Title="Truce Launcher"
        Width="1150" Height="760" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="7"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ==================== 标题栏 ==================== -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="23" Height="23" CornerRadius="6" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Truce Launcher" FontSize="13" FontWeight="SemiBold"
                               Margin="9,0,0,0" VerticalAlignment="Center" />
                    <Border Background="#0E000000" CornerRadius="5" Padding="7,2" Margin="9,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppVersion}" FontSize="10.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="OnMinimize"
                            ToolTip="最小化" />
                    <Button x:Name="MaxButton" Style="{StaticResource IconButton}" Content="&#xE922;"
                            Click="OnMaximize" ToolTip="最大化" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose"
                            ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <!-- ==================== 主体 ==================== -->
            <Grid Grid.Row="1" Margin="18,0,18,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="312" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：版本列表 -->
                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="游戏版本" Style="{StaticResource H1Text}" />
                            <Border Background="#0E000000" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding VersionCount, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" HorizontalAlignment="Right"
                                Command="{Binding RefreshCommand}" ToolTip="刷新版本列表" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Height="34"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="搜索版本 / 加载器…" IsHitTestVisible="False" Margin="12,0,0,0"
                                   VerticalAlignment="Center" FontSize="12.5"
                                   Foreground="{StaticResource TextTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox Grid.Row="2" Style="{StaticResource VersionList}" Margin="0,10,0,0"
                             ItemsSource="{Binding VersionsView}" SelectedItem="{Binding SelectedVersion}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13.5"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding LoaderTags}"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource AccentSoftBrush}"
                                                            CornerRadius="4" Padding="6,1.5" Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding}" FontSize="9.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    <TextBlock Text="{Binding MetaLine}" Style="{StaticResource TinyText}"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="正在扫描已安装版本…"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding McFolder}" Style="{StaticResource TinyText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding McFolder}" />
                        <Button Grid.Column="1" Content="打开目录" Style="{StaticResource GhostButton}"
                                Height="28" Padding="10,0" FontSize="11.5"
                                Command="{Binding OpenMcFolderCommand}" Margin="8,0,0,0" />
                    </Grid>
                </Grid>

                <!-- 右栏：设置区 -->
                <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel>

                        <!-- 启动卡片 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding SelectedVersionTitle}"
                                                   Style="{StaticResource H1Text}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SelectedVersion.MetaLine}"
                                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}"
                                            CornerRadius="8" Padding="10,5" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SelectedVersion.TypeLabel}" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,0" />

                                <TextBlock Text="玩家名称" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                                <TextBox Style="{StaticResource InputBox}"
                                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Margin="0,16,0,6">
                                    <TextBlock Text="内存分配" Style="{StaticResource FieldLabel}" Margin="0" />
                                    <TextBlock Text="{Binding RamText}" HorizontalAlignment="Right"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Grid>
                                <Slider Style="{StaticResource RamSlider}" Minimum="1"
                                        Maximum="{Binding MaxRamGb}" Value="{Binding RamGb}"
                                        IsEnabled="{Binding AutoMemory, Converter={StaticResource InverseBool}}" />
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="{Binding MemoryHint}" Style="{StaticResource TinyText}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <CheckBox Content="自动分配" Style="{StaticResource Switch}"
                                              IsChecked="{Binding AutoMemory}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <Button Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                                        Command="{Binding LaunchCommand}" IsEnabled="{Binding CanInteract}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,9,0" />
                                        <TextBlock Text="{Binding LaunchButtonText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Java 卡片 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Java 运行环境" Style="{StaticResource H2Text}" />
                                <ComboBox Style="{StaticResource ComboBoxBox}" Margin="0,11,0,0"
                                          ItemsSource="{Binding JavaList}"
                                          SelectedItem="{Binding SelectedJava}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="{Binding JavaHint}" Style="{StaticResource TinyText}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,110,0" />
                                    <Button Content="手动选择…" Style="{StaticResource GhostButton}"
                                            Height="30" Padding="11,0" HorizontalAlignment="Right"
                                            Command="{Binding BrowseJavaCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 游戏设置卡片 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="游戏设置" Style="{StaticResource H2Text}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="游戏语言" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource ComboBoxBox}"
                                                  ItemsSource="{Binding Languages}"
                                                  SelectedItem="{Binding SelectedLanguage}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="窗口尺寸" Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                                     Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextTertiaryBrush}" />
                                            <TextBox Grid.Column="2" Style="{StaticResource InputBox}"
                                                     Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <CheckBox Content="全屏启动" Style="{StaticResource Switch}"
                                              IsChecked="{Binding Fullscreen}" />
                                    <CheckBox Content="版本隔离" Style="{StaticResource Switch}"
                                              IsChecked="{Binding VersionIsolate}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 高级卡片 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="高级选项" Style="{StaticResource H2Text}" />

                                <TextBlock Text="JVM 参数（留空使用内置优化参数）"
                                           Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                                <TextBox Style="{StaticResource InputBoxMulti}" Height="56"
                                         Text="{Binding JvmArgs, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="游戏参数" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                                <TextBox Style="{StaticResource InputBox}"
                                         Text="{Binding GameArgs, UpdateSourceTrigger=PropertyChanged}" />

                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16" />

                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                                        <TextBlock Text="启动前整理内存" FontSize="12.5" />
                                        <TextBlock Text="清理待机列表，为 JVM 腾出连续可用内存"
                                                   Style="{StaticResource TinyText}" Margin="0,3,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="立即优化" Style="{StaticResource GhostButton}"
                                                Height="30" Padding="11,0" Margin="0,0,12,0"
                                                Command="{Binding OptimizeCommand}" />
                                        <CheckBox Style="{StaticResource Switch}"
                                                  IsChecked="{Binding MemoryOptimize}"
                                                  VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <Button Content="保存设置" Style="{StaticResource GhostButton}" Height="32"
                                        Padding="16,0" Margin="0,16,0,0" HorizontalAlignment="Right"
                                        Command="{Binding SaveCommand}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 底部：运行日志控制台 -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"
                        Background="{StaticResource CardBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="13,0,7,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE756;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="运行日志" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" />
                                <TextBlock Text="{Binding Logs.Count}" FontSize="10.5" Margin="7,0,0,0"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="清空" Style="{StaticResource GhostButton}" Height="24"
                                        Padding="9,0" FontSize="11" Command="{Binding ClearLogCommand}" />
                                <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                        Margin="5,0,0,0" Command="{Binding ToggleConsoleCommand}"
                                        ToolTip="展开 / 收起日志">
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE70D;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConsoleOpen}" Value="True">
                                                        <Setter Property="Text" Value="&#xE70E;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource ConsoleBgBrush}"
                                CornerRadius="0,0,9,9" Height="152"
                                Visibility="{Binding IsConsoleOpen, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                          Padding="13,9,10,9">
                                <ItemsControl ItemsSource="{Binding Logs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,1.5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10.5" Foreground="#FF6A7180" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource ConsoleTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 状态栏 ==================== -->
            <Grid Grid.Row="2" Margin="19,0,19,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Margin="7,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusDetail}" FontSize="11" Margin="10,0,0,0"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="740"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Powered by Go Core" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" />
            </Grid>
        </Grid>
    </Border>
</Window>
